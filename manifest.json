{
  "manifest_version": 3,
  "name": "ChatGPT TabFlow — Cognitive Developer OS",
  "version": "3.1.1",
  "minimum_chrome_version": "109",
  "description": "Local-first cognitive and performance layer for ChatGPT: persistent project memory, adaptive N-tab runtime, RAG, safe tab hibernation, Code Vault and multi-chat workspace.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "sidePanel",
    "tabGroups",
    "declarativeNetRequest",
    "offscreen",
    "unlimitedStorage",
    "system.memory"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "v3/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "ChatGPT TabFlow"
  },
  "side_panel": {
    "default_path": "v3/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content-scripts/memory-fetch-bridge.js",
        "content-scripts/fetch-proxy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content-scripts/runtime-agent.js",
        "content-scripts/memory-client.js",
        "content-scripts/booster.js"
      ],
      "css": [
        "content-scripts/booster.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Mở ChatGPT TabFlow Side Panel"
    },
    "freeze-background-tabs": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Đóng băng các tab ChatGPT nền đang thực sự nhàn rỗi"
    }
  }
}
